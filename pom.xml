<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.llamagen</groupId>
  <artifactId>llamagen-java</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>llamagen-java</name>
  <description>Java library for the LlamaGen API, including Comic API and Animation API clients.</description>
  <url>https://github.com/llamagenai/llamagen-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>llamagen</id>
      <name>LlamaGen</name>
      <email>support@llamagen.ai</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/llamagenai/llamagen-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/llamagenai/llamagen-java.git</developerConnection>
    <url>https://github.com/llamagenai/llamagen-java</url>
  </scm>

  <properties>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.3</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
